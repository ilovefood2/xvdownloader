{
  "manifest_version": 3,
  "name": "X Video Downloader",
  "version": "1.11.42",
  "description": "Hover over videos on x.com and other websites to download MP4 or HLS media.",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; object-src 'self'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "page": "src/background.html",
    "persistent": false
  },
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    },
    {
      "resources": ["src/generic-sniffer.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/main-world-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/download-bridge.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/main-world-loader.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/download-bridge.js", "src/generic-content.js"],
      "css": ["src/generic-styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
